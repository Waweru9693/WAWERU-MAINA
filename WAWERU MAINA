/* ── Reveal on scroll ── */
const io = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting){
      e.target.classList.add('on');
      e.target.querySelectorAll('.bar-fill').forEach(b=> b.style.width = b.dataset.w+'%');
    }
  });
},{threshold:.13});
document.querySelectorAll('.reveal').forEach((el,i)=>{ el.style.transitionDelay=(i%6)*.07+'s'; io.observe(el); });

/* ── Skills section ── */
const sio = new IntersectionObserver(entries=>{
  entries.forEach(e=>{
    if(e.isIntersecting) e.target.querySelectorAll('.bar-fill').forEach(b=>{ setTimeout(()=>b.style.width=b.dataset.w+'%',150); });
  });
},{threshold:.3});
document.querySelectorAll('#skills').forEach(el=>sio.observe(el));

