.contact-phones { display:flex; justify-content:center; gap:24px; margin-bottom:36px; font-family:'JetBrains Mono',monospace; font-size:.8rem; color:var(--muted); }
.contact-phones a { color:var(--muted); text-decoration:none; transition:color .3s; }
.contact-phones a:hover { color:var(--teal); }
.refs-title { font-family:'JetBrains Mono',monospace; font-size:.65rem; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); margin:40px 0 18px; }
.refs-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; text-align:left; }
.ref-card { background:var(--ink); border:1px solid var(--border); padding:18px 20px; }
.ref-name { font-size:.85rem; font-weight:500; color:var(--text); margin-bottom:3px; }
