.acc-text { font-size:.85rem; color:var(--muted); line-height:1.7; }
.acc-text strong { color:var(--text); font-weight:500; }

/* ══════ LEADERSHIP ══════ */
#leadership { background:var(--ink); }
.lead-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
.lead-card {
