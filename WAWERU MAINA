.lead-title { font-family:'Fraunces',serif; font-size:.95rem; font-weight:700; color:var(--text); margin-bottom:6px; }
.lead-org { font-size:.75rem; color:var(--muted); font-family:'JetBrains Mono',monospace; letter-spacing:.08em; }

/* ══════ CONTACT ══════ */
#contact { background:var(--ink2); text-align:center; }
.contact-wrap { max-width:560px; margin:0 auto; }
.contact-intro { color:var(--muted); font-size:.9rem; line-height:1.9; margin-bottom:48px; }
