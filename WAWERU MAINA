.ref-tel { font-family:'JetBrains Mono',monospace; font-size:.68rem; color:var(--teal); }

/* ══════ FOOTER ══════ */
footer { padding:24px 64px; border-top:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; font-family:'JetBrains Mono',monospace; font-size:.62rem; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); }

/* ══════ HERO ANIMATIONS ══════ */
.fade-a { opacity:0; animation:fu .8s forwards; }
.fade-a:nth-child(1){animation-delay:.2s}
.fade-a:nth-child(2){animation-delay:.4s}
.fade-a:nth-child(3){animation-delay:.6s}
.fade-a:nth-child(4){animation-delay:.8s}
.fade-a:nth-child(5){animation-delay:1s}
@keyframes fu { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:none} }

/* ══════ RESPONSIVE ══════ */
@media(max-width:960px){
  nav{padding:18px 24px;} nav.stuck{padding:12px 24px;}
